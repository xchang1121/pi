FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        findutils \
        git \
        procps \
        ripgrep \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8

CMD ["/bin/sh", "-c", "while :; do sleep 3600; done"]
